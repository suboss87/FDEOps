#!/bin/bash
# fdeops SessionStart - inject TRIAGE + bounded engagement context (not the full skill).
# Token discipline (L1 progressive disclosure): Claude/Cursor already discover @fde via
# skill metadata. Dumping skills/fde/SKILL.md here paid ~6-8k tokens every session even
# when the FDE was not doing field work. Load the skill body only when @fde triggers.

CONTEXT_FILE=""

resolve_engagement_dir() {
  local raw="$1"
  [ -z "$raw" ] && return 1
  # strip surrounding whitespace/quotes only - paths may contain spaces
  raw=$(printf '%s' "$raw" | sed -e 's/^[[:space:]"'"'"']*//' -e 's/[[:space:]"'"'"']*$//' -e "s|^~|$HOME|")
  [ -d "$raw" ] && printf '%s\n' "$raw" && return 0
  return 1
}

# Workspace registry written by `fde resume --init` - mirrors resolveEngagement()
# step 2 in bin/fde.js; keep the resolution order identical in bash and JS.
# Lines are "<workspace-path> <slug>": the path may contain spaces, the slug
# never does, so split on the LAST space (same as the JS lastIndexOf parse).
registry_engagement_dir() {
  # FDEOPS_ENGAGEMENTS_ROOT mirrors ENGAGEMENTS_ROOT in bin/fde.js - the CLI and
  # hooks MUST agree on the root or an isolated setup gets split memory.
  local root="${FDEOPS_ENGAGEMENTS_ROOT:-$HOME/fde-engagements}"
  root="${root/#\~/$HOME}"
  local reg="$root/.registry" slug
  [ -f "$reg" ] || return 1
  slug=$(awk 'BEGIN{ws=ENVIRON["PWD"]; best=-1}
    { i = match($0, / [^ ]*$/)
      if (i > 0) {
        wpath = substr($0, 1, i - 1)
        if (ws == wpath || index(ws, wpath "/") == 1) {
          if (length(wpath) > best) { best = length(wpath); slug = substr($0, i + 1) }
        }
      } }
    END { if (best >= 0) print slug }' "$reg" 2>/dev/null)
  [ -z "$slug" ] && return 1
  [ -d "$root/$slug/.fde" ] && printf '%s\n' "$root/$slug/.fde" && return 0
  return 1
}

# 1) Environment variable (any agent)
if [ -z "$CONTEXT_FILE" ]; then
  ENG_DIR=$(resolve_engagement_dir "${FDEOPS_ENGAGEMENT:-${FDEOS_ENGAGEMENT:-}}")
  [ -n "$ENG_DIR" ] && CONTEXT_FILE="$ENG_DIR/context.md"
fi

# 2) Workspace registry binding (written by fde resume --init)
if [ -z "$CONTEXT_FILE" ]; then
  ENG_DIR=$(registry_engagement_dir)
  [ -n "$ENG_DIR" ] && CONTEXT_FILE="$ENG_DIR/context.md"
fi

# 3) Project CLAUDE.md
if [ -z "$CONTEXT_FILE" ] && [ -f "CLAUDE.md" ]; then
  ENG=$(grep -m1 '^FDEOPS_ENGAGEMENT=\|^FDEOS_ENGAGEMENT=' CLAUDE.md 2>/dev/null | cut -d= -f2-)
  ENG_DIR=$(resolve_engagement_dir "$ENG")
  [ -n "$ENG_DIR" ] && CONTEXT_FILE="$ENG_DIR/context.md"
fi

# 4) Global fdeops pointer file
if [ -z "$CONTEXT_FILE" ] && [ -f "$HOME/.claude/FDEOPS-CLAUDE.md" ]; then
  ENG=$(grep -m1 '^FDEOPS_ENGAGEMENT=\|^FDEOS_ENGAGEMENT=' "$HOME/.claude/FDEOPS-CLAUDE.md" 2>/dev/null | cut -d= -f2-)
  ENG_DIR=$(resolve_engagement_dir "$ENG")
  [ -n "$ENG_DIR" ] && CONTEXT_FILE="$ENG_DIR/context.md"
fi

# 5) Optional in-repo .fde (customer-approved only)
if [ -z "$CONTEXT_FILE" ] && [ -f ".fde/context.md" ]; then
  CONTEXT_FILE=".fde/context.md"
fi

IS_FDE_PROJECT=0
[ -n "$CONTEXT_FILE" ] && [ -f "$CONTEXT_FILE" ] && IS_FDE_PROJECT=1
[ -f "CLAUDE.md" ] && grep -qi "fde\|fdeops" "CLAUDE.md" 2>/dev/null && IS_FDE_PROJECT=1
[ -n "${FDEOPS_ENGAGEMENT:-${FDEOS_ENGAGEMENT:-}}" ] && IS_FDE_PROJECT=1
[ -d ".fde" ] && IS_FDE_PROJECT=1

if [ "$IS_FDE_PROJECT" -eq 0 ]; then
  exit 0
fi

# Mirrors stripPrivate() in bin/fde.js: this is what an agent loads as
# context, so <private>...</private> blocks (sacred data, never-AI content)
# must never reach here unredacted, same guarantee as the dashboard renderer.
# <private> blocks are written one per line in the templates (own line, own
# closing tag), so a line-based state machine matches the real usage; an
# unclosed <private> redacts to end-of-file, same as the JS regex fallback.
strip_private() {
  # Detection is case-insensitive (matches the JS /gi redactor) - <PRIVATE>,
  # <Private>, <private> all redact. Detect on a lowercased copy of the line;
  # never print the original when a tag is present.
  awk '
    BEGIN { inblock = 0 }
    {
      line = $0
      lc = tolower(line)
      if (inblock) {
        if (index(lc, "</private>") > 0) { inblock = 0 }
        next
      }
      if (index(lc, "<private>") > 0) {
        print "(private - redacted)"
        if (index(lc, "</private>") == 0) { inblock = 1 }
        next
      }
      print line
    }
  ' "$1"
}

# Token discipline: context.md grows every session (session-stop appends a
# snapshot). Inject a bounded view - curated head + most recent activity -
# instead of the whole log. Mirrors resumeView() in bin/fde.js; keep in sync.
bounded_context() {
  local f="$1" total head_end tail_start hidden
  total=$(wc -l < "$f" 2>/dev/null | tr -d ' ')
  [ -z "$total" ] && { cat "$f"; return; }
  if [ "$total" -le 160 ]; then cat "$f"; return; fi
  # Anchor on the "## Session end" heading, matching resumeView() in bin/fde.js.
  # The JS path reads via readClean (strips HTML comments), so both sides must
  # anchor on a marker that survives redaction - the heading, not the comment.
  head_end=$(grep -n -m1 '^## Session end' "$f" 2>/dev/null | cut -d: -f1)
  if [ -n "$head_end" ]; then head_end=$((head_end - 1)); else head_end=120; fi
  [ "$head_end" -gt 120 ] && head_end=120
  [ "$head_end" -lt 0 ] && head_end=0
  tail_start=$((total - 40 + 1))
  if [ "$tail_start" -le "$((head_end + 1))" ]; then cat "$f"; return; fi
  hidden=$((tail_start - head_end - 1))
  [ "$head_end" -ge 1 ] && sed -n "1,${head_end}p" "$f"
  printf '\n_(… %s lines of earlier session log hidden - `fde resume --full` or open context.md for the full history)_\n\n' "$hidden"
  sed -n "${tail_start},\$p" "$f"
}

CONTENT=""

# Lean pointer only - never cat SKILL.md. Methods load on @fde / skill trigger.
CONTENT="${CONTENT}fdeops: engagement fieldbook active. Human speaks plain language with @fde - you (the agent) run the local fde CLI for memory plumbing; never ask the human to type fde commands. Load skills/fde/SKILL.md when @fde triggers.\n\n"

# Same TRIAGE block as `fde resume` / `fde triage` - Monday morning must not
# depend on the model remembering to run a CLI command. Prefer the installed
# fde binary; fall back to the plugin/repo copy of bin/fde.js.
resolve_fde() {
  if command -v fde >/dev/null 2>&1; then
    printf '%s\n' "fde"
    return 0
  fi
  for candidate in \
    "${CLAUDE_PLUGIN_ROOT:+$CLAUDE_PLUGIN_ROOT/bin/fde.js}" \
    "$(dirname "$0")/../bin/fde.js" \
    "$HOME/.claude/fdeops/fde.js" \
    "$HOME/.claude/plugins/fdeops/bin/fde.js"; do
    if [ -n "$candidate" ] && [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done
  return 1
}

if [ -n "$CONTEXT_FILE" ] && [ -f "$CONTEXT_FILE" ]; then
  FDE_CMD=$(resolve_fde || true)
  if [ -n "$FDE_CMD" ]; then
    if [ "$FDE_CMD" = "fde" ]; then
      TRIAGE=$(fde triage 2>/dev/null || true)
    else
      TRIAGE=$(node "$FDE_CMD" triage 2>/dev/null || true)
    fi
    if [ -n "$TRIAGE" ]; then
      CONTENT="$CONTENT---\n$TRIAGE\n\n"
    fi
  fi
  REDACTED_CONTEXT=$(mktemp)
  strip_private "$CONTEXT_FILE" > "$REDACTED_CONTEXT"
  CONTENT="$CONTENT---\nEngagement context ($CONTEXT_FILE):\n$(bounded_context "$REDACTED_CONTEXT")\n"
  rm -f "$REDACTED_CONTEXT"
fi

printf '%b' "$CONTENT"
