#!/bin/bash
# fdeops PreCompact - preserve engagement state before context compaction.
# Resolves the engagement the same way as session-start/session-stop.

resolve_engagement_dir() {
  local raw="$1"
  [ -z "$raw" ] && return 1
  # strip surrounding whitespace/quotes only - paths may contain spaces
  raw=$(printf '%s' "$raw" | sed -e 's/^[[:space:]"'"'"']*//' -e 's/[[:space:]"'"'"']*$//' -e "s|^~|$HOME|")
  [ -d "$raw" ] && printf '%s\n' "$raw" && return 0
  return 1
}

# Workspace registry written by `fde resume --init` - mirrors resolveEngagement()
# step 2 in bin/fde.js; keep the resolution order identical in bash and JS.
# Lines are "<workspace-path> <slug>": the path may contain spaces, the slug
# never does, so split on the LAST space (same as the JS lastIndexOf parse).
registry_engagement_dir() {
  local reg="$HOME/fde-engagements/.registry" slug
  [ -f "$reg" ] || return 1
  slug=$(awk 'BEGIN{ws=ENVIRON["PWD"]; best=-1}
    { i = match($0, / [^ ]*$/)
      if (i > 0) {
        wpath = substr($0, 1, i - 1)
        if (ws == wpath || index(ws, wpath "/") == 1) {
          if (length(wpath) > best) { best = length(wpath); slug = substr($0, i + 1) }
        }
      } }
    END { if (best >= 0) print slug }' "$reg" 2>/dev/null)
  [ -z "$slug" ] && return 1
  [ -d "$HOME/fde-engagements/$slug/.fde" ] && printf '%s\n' "$HOME/fde-engagements/$slug/.fde" && return 0
  return 1
}

ENG_DIR=$(resolve_engagement_dir "${FDEOPS_ENGAGEMENT:-${FDEOS_ENGAGEMENT:-}}")

if [ -z "$ENG_DIR" ]; then
  ENG_DIR=$(registry_engagement_dir)
fi

if [ -z "$ENG_DIR" ] && [ -f "CLAUDE.md" ]; then
  ENG=$(grep -m1 '^FDEOPS_ENGAGEMENT=\|^FDEOS_ENGAGEMENT=' CLAUDE.md 2>/dev/null | cut -d= -f2-)
  ENG_DIR=$(resolve_engagement_dir "$ENG")
fi

if [ -z "$ENG_DIR" ] && [ -f "$HOME/.claude/FDEOPS-CLAUDE.md" ]; then
  ENG=$(grep -m1 '^FDEOPS_ENGAGEMENT=\|^FDEOS_ENGAGEMENT=' "$HOME/.claude/FDEOPS-CLAUDE.md" 2>/dev/null | cut -d= -f2-)
  ENG_DIR=$(resolve_engagement_dir "$ENG")
fi

if [ -z "$ENG_DIR" ] && [ -d ".fde" ]; then
  ENG_DIR=".fde"
fi

[ -z "$ENG_DIR" ] && exit 0

CONTEXT_FILE="$ENG_DIR/context.md"
DECISIONS_FILE="$ENG_DIR/decisions.md"
RISKS_FILE="$ENG_DIR/risks.md"
MARKER="[fdeops context preserved"

[ -f "$CONTEXT_FILE" ] || exit 0

# Avoid unbounded growth: skip if we already preserved today.
if grep -Fq "$MARKER" "$CONTEXT_FILE" 2>/dev/null; then
  LAST=$(grep -F "$MARKER" "$CONTEXT_FILE" | tail -1)
  if echo "$LAST" | grep -q "$(date -u +%Y-%m-%d)"; then
    exit 0
  fi
fi

# Redact <private> before extracting lines - this content is appended to
# context.md, which session-start loads into the model. A closed private block
# collapses to one placeholder line, so its inner text can't be tail'd or
# grepped out tag-stripped. Case-insensitive, mirrors the JS /gi redactor.
strip_private() {
  awk '
    BEGIN { inblock = 0 }
    {
      line = $0
      lc = tolower(line)
      if (inblock) { if (index(lc, "</private>") > 0) { inblock = 0 } next }
      if (index(lc, "<private>") > 0) {
        print "(private - redacted)"
        if (index(lc, "</private>") == 0) { inblock = 1 }
        next
      }
      print line
    }
  ' "$1"
}

TIMESTAMP=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
LAST_DECISIONS=""
OPEN_RISKS=""

[ -f "$DECISIONS_FILE" ] && LAST_DECISIONS=$(strip_private "$DECISIONS_FILE" 2>/dev/null | tail -20)
[ -f "$RISKS_FILE" ] && OPEN_RISKS=$(strip_private "$RISKS_FILE" 2>/dev/null | grep -iE "open|active|unresolved" | head -8)

cat >> "$CONTEXT_FILE" 2>/dev/null << EOF

---
$MARKER at $TIMESTAMP]
Recent decisions (tail):
$LAST_DECISIONS

Open risks:
$OPEN_RISKS
---
EOF

exit 0
